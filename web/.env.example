# Higgsfield API key, format key-id:key-secret (server-side only, never NEXT_PUBLIC_)
HF_CREDENTIALS=
# Max generations per IP per hour on /api/hf/generate (default 30)
HF_HOURLY_LIMIT=30
# InsForge (accounts). URL and anon key are public by design; the anon key is not an admin key.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Public site origin, used for the Google sign-in return URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
